# RACEJUDGE — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# ── Phase 1: Infrastructure ─────────────────────────────────────────────────

# PostgreSQL (Neon) — get connection string from neon.tech console
DATABASE_URL=postgresql://user:password@host/racejudge?sslmode=require

# Redis (Upstash or self-hosted) — used by Celery task queue
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 — for storing raw PDFs and audio files
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=racejudge-pdfs
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Phase 2: ML / Embeddings ─────────────────────────────────────────────────

# OpenAI (used only for RAG fallback / GPT-4o mini re-ranking if needed)
OPENAI_API_KEY=sk-...

# Anthropic (Claude as fallback reasoning layer)
ANTHROPIC_API_KEY=sk-ant-...

# Modal (GPU inference for Faster-Whisper, BGE-M3, Llama LoRA)
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret

# Hugging Face (model weights download)
HF_TOKEN=hf_...

# ── Phase 5–6: Web App ───────────────────────────────────────────────────────

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe (billing — Pro $29/mo, Team $499/mo)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# ── Phase 6–7: Integrations ──────────────────────────────────────────────────

# OpenF1 API (no auth needed for public endpoints, but set base URL)
OPENF1_BASE_URL=https://api.openf1.org/v1

# Fly.io (deployment — used in CI/CD)
FLY_API_TOKEN=fo1_...
FLY_APP_NAME=racejudge-api

# ── Phase 7: API tier ────────────────────────────────────────────────────────

# API key encryption secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
API_KEY_ENCRYPTION_SECRET=your_64_char_hex_string

# ── App config ──────────────────────────────────────────────────────────────

# FastAPI
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Scraper rate limiting (seconds between requests to fia.com)
REQUEST_DELAY=5.0
